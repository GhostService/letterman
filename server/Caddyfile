# Caddy gets and renews the HTTPS certificate for this domain automatically.
# Change the domain if you use a different one.
hours.tiredghost.com {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	request_body {
		max_size 10MB
	}

	# PocketBase only listens on localhost; Caddy is the only way in.
	reverse_proxy 127.0.0.1:8090
}
