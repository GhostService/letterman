# systemd service for PocketBase. Install with the steps in FIRST_SETUP.md (Part B).
[Unit]
Description=Letterman backend (PocketBase)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pocketbase
Group=pocketbase
WorkingDirectory=/opt/letterman
# Holds PB_FIELD_KEY. Readable by root only; systemd passes it to the process.
EnvironmentFile=/etc/letterman/pocketbase.env
ExecStart=/opt/letterman/pocketbase serve \
    --http 127.0.0.1:8090 \
    --dir /opt/letterman/pb_data \
    --hooksDir /opt/letterman/pb_hooks \
    --migrationsDir /opt/letterman/pb_migrations \
    --publicDir /opt/letterman/pb_public \
    --hooksWatch=false \
    --automigrate=false \
    --encryptionEnv PB_FIELD_KEY
Restart=always
RestartSec=5
LimitNOFILE=4096

# Hardening: the service can only write to its data folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/letterman/pb_data

[Install]
WantedBy=multi-user.target
